# Stageplot is public on all network interfaces by default.
STAGEPLOT_PORT=8088

# Studio is available on the local network. Do not forward this port publicly.
STUDIO_BIND=0.0.0.0
STUDIO_PORT=8089

# For Unraid, use a directory outside the copied source folder, for example:
# LIBRARY_DATA_PATH=/mnt/user/appdata/stage-layout-app-data
LIBRARY_DATA_PATH=.

# Images published automatically by GitHub Actions.
IMAGE_PREFIX=ghcr.io/staljabro/stage-layout-app
IMAGE_TAG=latest

# Enable when public access uses HTTPS (including TLS at a reverse proxy).
STAGEPLOT_SECURE_COOKIE=false
# Optional exact browser origins for a separately hosted frontend, comma-separated.
# Same-origin frontend/API proxying requires no list.
STAGEPLOT_ALLOWED_ORIGINS=
