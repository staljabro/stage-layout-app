# Stageplot is public on all network interfaces by default.
STAGEPLOT_PORT=8088

# For Unraid, use a directory outside the copied source folder, for example:
# LIBRARY_DATA_PATH=/mnt/user/appdata/stage-layout-app-data
LIBRARY_DATA_PATH=.

# Images published automatically by GitHub Actions.
IMAGE_PREFIX=ghcr.io/staljabro/stage-layout-app
IMAGE_TAG=latest

# Enable when public access uses HTTPS (including TLS at a reverse proxy).
STAGEPLOT_SECURE_COOKIE=false
# Leave blank for localhost or one hostname. For trusted sibling subdomains:
# STAGEPLOT_COOKIE_DOMAIN=braithwaite.work (shared cookies require HTTPS).
STAGEPLOT_COOKIE_DOMAIN=
# Optional exact browser origins for a separately hosted frontend, comma-separated.
# Same-origin frontend/API proxying requires no list.
STAGEPLOT_ALLOWED_ORIGINS=

# Register a GitHub OAuth App. Keep the client secret on the API server only.
# New verified GitHub accounts become Users automatically; no signup approval gate.
STAGEPLOT_GITHUB_CLIENT_ID=
STAGEPLOT_GITHUB_CLIENT_SECRET=
# The OAuth App's callback must exactly match this URL. Use HTTPS in production.
STAGEPLOT_GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback
# Use the same hostname, or configure a shared parent cookie domain above.
STAGEPLOT_APP_URL=http://localhost:5173/
# Optional additional trusted frontend; equipment authoring is included in the main app.
STAGEPLOT_STUDIO_URL=
# Numeric GitHub account ID (the "id" field at https://api.github.com/users/YOUR_USERNAME).
# Configure before the intended Owner's first sign-in. Other new accounts stay Users.
STAGEPLOT_GITHUB_OWNER_ID=
# Optional existing app Owner ID; required when more than one active Owner exists.
STAGEPLOT_OWNER_USER_ID=
